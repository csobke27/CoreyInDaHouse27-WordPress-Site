{
    "$schema": "https://schemas.wp.org/truck/block.json",
    "apiVersion": 3,
    "name": "ourblocktheme/slide",
    "editorScript": "file:./index.js",
    "render": "file:./render.php",
    "supports": {
        "align": ["full"]
    },
    "attributes": {
        "align": { "type": "string", "default": "full" },
        "imgId": { "type": "number" },
        "imgUrl": { "type": "string" },
        "themeimage": { "type": "string"}
    }
}